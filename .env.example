# Neon: pooled connection, used by the app at runtime (lib/prisma.ts)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon: direct (unpooled) connection, used by Prisma migrations (prisma.config.ts)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# NextAuth secret: generate with `openssl rand -base64 32`
AUTH_SECRET=""
